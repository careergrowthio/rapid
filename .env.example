# Rapid — environment template. Copy to .env and fill in. NEVER commit .env.
# .env is gitignored. Secrets live here only — never in code, logs, or commits.

# --- Claude (matching + resume tailoring) ---
ANTHROPIC_API_KEY=

# --- Supabase (single datastore; service role bypasses RLS, server-side only) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Apify (Fantastic Jobs scraping) ---
APIFY_TOKEN=

# --- Google (Docs/Drive: read masters, write tailored resumes) ---
# Either a PATH to the service-account JSON key file (gitignored), OR paste the
# whole JSON contents here directly (easier for cloud envs). The loader accepts both.
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
# CLOUD SESSIONS (Claude Code on the web): the env-var field is single-line only
# (.env format, one KEY=value per line). A multi-line JSON value corrupts the save
# and silently drops EVERY variable. So in cloud, do NOT paste raw JSON. Instead
# base64-encode the key file into one line and set GOOGLE_SERVICE_ACCOUNT_JSON_B64.
# scripts/bootstrap_secrets.sh (SessionStart hook) decodes it to .secrets/ on start.
#   Make the value with:  base64 -w0 service_account.json   (macOS: base64 -i service_account.json)
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
RESUME_TEMPLATE_DOC_ID=
# Drive folders already shared with the service account:
DRIVE_MASTERS_FOLDER_ID=1YzCQF-V2K1LLbGiZgvsov7KEzoTqX9YT
DRIVE_OUTPUT_FOLDER_ID=1X6PUnQydfjImEwQOisF1NdJwPy6D71ZV

# --- Postmark (Transactional stream) ---
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_ADDRESS=rapidnotifications@careergrowth.io
OPS_ALERT_EMAIL=

# --- SAFETY: test mode. Until the shadow-run passes, every email goes ONLY here. ---
TEST_RECIPIENT_OVERRIDE=
